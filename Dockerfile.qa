FROM node:22-alpine AS build
WORKDIR /app

# CI mode + increase Node heap for large Angular builds
ENV CI=true \
    NODE_OPTIONS=--max_old_space_size=2048

# Copy lockfiles first to leverage build cache and ensure reproducible installs
COPY package*.json ./

# Use BuildKit cache to speed up repeated installs and keep runtime image clean
RUN --mount=type=cache,target=/root/.npm \
    npm ci

# Copy source and run the QA build
COPY . .
RUN --mount=type=cache,target=/root/.npm \
    npm run build:qa


FROM nginx:1.25-alpine AS runtime

# Drop in a tuned server block (gzip, caching, SPA fallback) via custom vhost
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf

# Copy the Angular build artifacts to the NGINX web root
COPY --from=build /app/dist/ticket/browser /usr/share/nginx/html

# Container port
EXPOSE 80

# Keep NGINX in the foreground so Docker tracks the main process
CMD ["nginx","-g","daemon off;"]
